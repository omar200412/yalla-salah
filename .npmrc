# @firebase/auth declares an *optional* peer dependency on
# @react-native-async-storage/async-storage ^1.18.1, but Expo SDK 54 requires
# 2.2.0. Newer npm tolerates the mismatch; the older npm on EAS Build tries to
# add a nested 1.24.0 copy that is absent from package-lock.json, which makes
# `npm ci` fail with:
#
#   npm error Missing: @react-native-async-storage/async-storage@1.24.0 from lock file
#
# Ignoring peer resolution makes the dependency tree (and therefore the
# lockfile) identical locally and on the build server.
legacy-peer-deps=true
