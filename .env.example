# Copy this file to `.env` and paste the values from your Firebase project:
#   Firebase console -> Project settings -> General -> "Your apps" -> Web app -> SDK setup and configuration
#
# These are client-side identifiers, NOT secrets. Access to your data is protected
# by the Firestore security rules in `firestore.rules`, not by hiding these values.
# `.env` is git-ignored anyway so you do not accidentally commit environment-specific config.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
